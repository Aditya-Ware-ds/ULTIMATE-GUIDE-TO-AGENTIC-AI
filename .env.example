# Copy to .env and fill in only the providers you plan to use for `make test-live`.
# `make test` (the default, offline suite) needs none of these -- it uses the mock
# provider in shared/llm/mock.py.

# Which provider `shared.llm.get_client()` uses when no provider is passed explicitly.
# One of: mock, anthropic, openai, gemini, ollama
LLM_PROVIDER=mock

# --- Anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ollama (local models, no key needed) ---
# Only needed if your Ollama server isn't on the default http://localhost:11434
OLLAMA_HOST=

# --- Module 14 (browser agents) ---
# Playwright browsers are installed separately via `uv run playwright install`; no
# key needed for the offline labs.

# --- Module 19 (deployment) ---
# Only needed if you deploy the sample FastAPI service somewhere with its own auth.
APP_API_KEY=
